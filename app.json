{
  "expo": {
    "name": "Scout",
    "slug": "scout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "scout",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scout uses your camera to detect ticks, fleas, and parasites in real time."
      }
    },
    "android": {
      "package": "com.uyobonus.scout",
      "adaptiveIcon": {
        "backgroundColor": "#0A0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "./plugins/withAppShortcuts",
        {
          "shortcuts": [
            {
              "id": "flash",
              "shortLabel": "Flash",
              "longLabel": "Activate Flashlight",
              "icon": "flash",
              "deepLink": "scout://scan?preset=flashlight"
            },
            {
              "id": "scan",
              "shortLabel": "Scan",
              "longLabel": "Quick Scan",
              "icon": "scan",
              "deepLink": "scout://scan"
            },
            {
              "id": "camp",
              "shortLabel": "Camp",
              "longLabel": "Camp Mode",
              "icon": "camp",
              "deepLink": "scout://scan?preset=camp"
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0D12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scout uses your camera to detect ticks, fleas, and parasites in real time."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00F5D4"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "528760cf-4835-40e4-a3c9-2fa53e1a9f8b"
      }
    },
    "owner": "lengue"
  }
}
